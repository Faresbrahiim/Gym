# -------------------------------------------------------
# booking-service build context: microservices/booking-service/backend
# Needs: composer.json, composer.lock, src/, config/, docker/, bin/
# -------------------------------------------------------

# PHP dependencies — reinstalled inside container by composer install
# IMPORTANT: local vendor may contain Windows binaries; container needs Linux ones
vendor/

# Symfony runtime cache & logs — generated at container startup
var/

# Local env files — injected via docker-compose environment
.env
.env.local
.env.*.local

# Git & IDE
.git/
.idea/
.vscode/

# Test directories — not needed in image
tests/

# OS
.DS_Store
Thumbs.db
